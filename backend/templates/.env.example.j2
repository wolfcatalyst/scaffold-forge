# App
APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8000
{% if stack.auth == "jwt" %}

# Auth
JWT_SECRET=changeme
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=60
{% endif %}
{% if stack.database == "postgresql" %}

# Database
DATABASE_URL=postgresql://user:password@localhost:5432/dbname
{% elif stack.database == "sqlite" %}

# Database
DATABASE_URL=sqlite:///./app.db
{% endif %}
{% if ai_providers %}

# AI
AI_PRIMARY_PROVIDER={{ stack.ai_primary_provider }}
AI_PRIMARY_MODEL={{ {"anthropic": "claude-sonnet-5-5", "openai": "gpt-4o-mini", "ollama": "llama3.2", "google": "gemini-2.5-flash"}.get(stack.ai_primary_provider, "") }}
{% if "anthropic" in ai_providers %}
ANTHROPIC_API_KEY=
{% endif %}
{% if "openai" in ai_providers %}
OPENAI_API_KEY=
{% endif %}
{% if "ollama" in ai_providers %}
OLLAMA_BASE_URL=http://localhost:11434
{% endif %}
{% if "google" in ai_providers %}
GOOGLE_API_KEY=
{% endif %}
{% if "custom" in ai_providers %}
CUSTOM_AI_BASE_URL=
CUSTOM_AI_API_KEY=
{% endif %}
{% endif %}
{% if stack.frontend != "none" %}

# CORS
CORS_ORIGINS=http://localhost:5173
{% endif %}
