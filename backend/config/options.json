  "data_lifecycle": {
    "survive_restart": {
      "question": "Does any data need to survive a server restart?",
      "options": [
        { "id": "no", "label": "No — results are consumed immediately and discarded" },
        { "id": "yes", "label": "Yes — users/data need to persist" }
      ]
    },
    "return_to_previous": {
      "question": "Do users come back to find previous work?",
      "options": [
        { "id": "no", "label": "No — each session is independent" },
        { "id": "yes", "label": "Yes — history/state must be retrievable" }
      ]
    },
    "search_query": {
      "question": "Does anything need to be searched or queried later?",
      "options": [
        { "id": "no", "label": "No — data flows through and exits" },
        { "id": "yes", "label": "Yes — needs indexing/querying" }
      ]
    },
    "user_data_isolation": {
      "question": "Is there a meaningful difference between users' data?",
      "options": [
        { "id": "no", "label": "No — single-user or shared state" },
        { "id": "yes", "label": "Yes — per-user data isolation required" }
      ]
    }
  },
