{
  "name": "Wolf Local Desktop Tool",
  "config": {
    "intent": {
      "project_type": "desktop_app",
      "users": "just_me",
      "lifespan": "long_term"
    },
    "data_lifecycle": {
      "survive_restart": "yes",
      "return_to_previous": "yes",
      "search_query": "no",
      "user_data_isolation": "no"
    },
    "stack": {
      "target": "electron",
      "backend": "fastapi",
      "backend_language": "python",
      "runtime": "venv",
      "frontend": "react",
      "styling": "tailwind",
      "component_library": "shadcn",
      "theme": "dark",
      "database": "json_files",
      "orm": "none",
      "auth": "none",
      "multiuser": "no",
      "docker": "no",
      "ai_integration": "single",
      "ai_primary_provider": "anthropic",
      "ai_pattern": "response_agent",
      "git": "init",
      "build": "makefile",
      "linting": "both"
    }
  }
}